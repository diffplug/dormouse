{
  "name": "dor-tools-lib",
  "version": "0.0.0",
  "description": "The Dor Tool integration protocol: OSC 367 announcements and the iframe save channel, for Tools and the hosts that run them.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./frame": {
      "types": "./dist/frame.d.ts",
      "default": "./dist/frame.js"
    },
    "./osc": {
      "types": "./dist/osc.d.ts",
      "default": "./dist/osc.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.0"
  }
}
