// Every type-checking tsconfig that reaches an internal package extends this,
// so tsc reads its source rather than a dist; `workspaceSourcePaths` in
// scripts/workspace-sources.mjs generates the block, and
// scripts/workspace-sources.test.mjs pins it.
{
  "compilerOptions": {
    "paths": {
      "dormouse-lib/*": ["./lib/src/*"],
      "dor/*": ["./dor/src/*"],
      "dor-lib-common": ["./dor-lib-common/src/index.ts"],
      "dor-lib-common/*": ["./dor-lib-common/src/*"],
      "dor-tools-builtin/*": ["./dor-tools-builtin/src/*"],
      "dor-tools-lib/*": ["./dor-tools-lib/src/*"],
      "remote-lib-common": ["./remote-lib-common/src/index.ts"],
      "remote-lib-common/*": ["./remote-lib-common/src/*"]
    }
  }
}
