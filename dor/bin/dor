#!/bin/sh
if [ -n "${DORMOUSE_NODE:-}" ] && [ -n "${DORMOUSE_CLI_JS:-}" ]; then
  # Under VS Code, DORMOUSE_NODE is the editor's Electron binary, which only
  # behaves as Node when ELECTRON_RUN_AS_NODE is set; plain Node ignores it.
  # Set it here rather than relying on the ambient env to carry it: terminals
  # routinely strip it (so Electron apps launched from a shell don't
  # misbehave), and without it Electron launches its GUI, ignores the script,
  # and exits 0 — so `dor` would silently do nothing.
  ELECTRON_RUN_AS_NODE=1
  export ELECTRON_RUN_AS_NODE
  # WSL runs the Windows runtime so it can open the host's named pipe. Only
  # the executable needs a Linux spelling; Node still expects a Windows script
  # path. wslpath respects the distro's configured automount root.
  NODE_EXEC=$DORMOUSE_NODE
  if [ -n "${WSL_DISTRO_NAME:-}" ]; then
    case "$DORMOUSE_NODE" in
      [A-Za-z]:*) NODE_EXEC=$(wslpath -u "$DORMOUSE_NODE") || exit 1 ;;
    esac
  fi
  exec "$NODE_EXEC" "$DORMOUSE_CLI_JS" "$@"
fi

SCRIPT_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
exec node "$SCRIPT_DIR/../dist/dor.js" "$@"
