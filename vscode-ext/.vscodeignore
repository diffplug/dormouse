# vsce warns that the extension should be bundled: it counts the Markdown
# viewer's lazy chunks in dor-cli/dist/builtin/viewer, which stay split on
# purpose (dor-tools-builtin/scripts/build-viewer.mjs). The extension host's
# own code is already bundled into dist/extension.js and dist/pty-host.js.
src/
test/
scripts/
node_modules/
*.mts
icon-no-border.svg
.gitignore
tsconfig.json
pnpm-lock.yaml
pnpm-workspace.yaml
icon.svg
*.vsix
*.ts
# Also ships the zsh shell-integration dotfiles (dist/shell-integration/.z*).
# Nothing asserts they are packaged; dropped, zsh silently degrades to the
# keystroke fallback.
!dist/**
!media/**
!images/**
!icon.png
!README.md
!CHANGELOG.md
!LICENSE
