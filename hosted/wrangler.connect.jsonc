{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dormouse-connect",
  "main": "server/connect-worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "connect.dormouse.sh",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/connect",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "https://connect.dormouse.sh"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ONE_TIME_ROOM",
        "class_name": "OneTimeRoom"
      }
    ]
  },
  // Append-only: a deployed tag is never edited.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OneTimeRoom"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "ONE_TIME_JOIN_LIMIT",
      "namespace_id": "2",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
