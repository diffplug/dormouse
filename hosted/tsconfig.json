{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["node", "vite/client"],
    "paths": {
      "dormouse-lib/*": ["../lib/src/*"],
      "dor/*": ["../dor/src/*"],
      "dor-lib-common": ["../dor-lib-common/src/index.ts"],
      "dor-lib-common/*": ["../dor-lib-common/src/*"],
      "dor-tools-builtin/*": ["../dor-tools-builtin/src/*"],
      "dor-tools-lib/*": ["../dor-tools-lib/src/*"],
      "remote-lib-common": ["../remote-lib-common/src/index.ts"],
      "remote-lib-common/*": ["../remote-lib-common/src/*"]
    }
  },
  "include": ["src", "server", "vite.config.ts", "vitest.config.ts"]
}
