{
  "name": "dormouse-lib",
  "version": "1.1.0",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pocket": "vite --config vite.pocket.config.ts",
    "prebuild": "pnpm --filter dor-lib-common build && pnpm --filter server-lib-common build",
    "build": "tsc -b && vite build",
    "build:pocket": "vite build --config vite.pocket.config.ts && vite build --config vite.sw.config.ts && node scripts/assert-pocket-worker.mjs",
    "preview": "vite preview",
    "pretest": "pnpm --filter dor-lib-common build && pnpm --filter server-lib-common build",
    "test": "pnpm typecheck && vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open --ci",
    "build-storybook": "storybook build",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-unicode-graphemes": "0.5.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/xterm": "6.1.0-beta.304",
    "clsx": "^2.1.1",
    "dor-lib-common": "workspace:*",
    "fflate": "0.8.3",
    "jsonc-parser": "3.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "server-lib-common": "workspace:*",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/react": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "chromatic": "^17.0.0",
    "fake-indexeddb": "^6.2.5",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.6"
  }
}
