{
  "name": "dormouse-lib",
  "version": "1.2.0",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pocket": "vite --config vite.pocket.config.ts",
    "prebuild": "pnpm --filter dor-lib-common build && pnpm --filter remote-lib-common build",
    "build": "tsc -b && vite build",
    "build:pocket": "vite build --config vite.pocket.config.ts && vite build --config vite.sw.config.ts && node scripts/assert-pocket-worker.mjs",
    "build:one-time": "vite build --config vite.one-time.config.ts && node scripts/assert-pocket-worker.mjs --one-time",
    "preview": "vite preview",
    "pretest": "pnpm --filter dor-lib-common build && pnpm --filter remote-lib-common build",
    "test": "pnpm typecheck && vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open --ci",
    "build-storybook": "storybook build",
    "test:argos": "vitest run --config vitest.argos.config.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-image": "0.10.0-beta.301",
    "@xterm/addon-serialize": "0.15.0-beta.301",
    "@xterm/addon-unicode-graphemes": "0.5.0-beta.301",
    "@xterm/addon-webgl": "0.20.0-beta.300",
    "@xterm/xterm": "6.1.0-beta.304",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "clsx": "^2.1.1",
    "dor-lib-common": "workspace:*",
    "dor-tools-lib": "workspace:*",
    "fflate": "0.8.3",
    "jsonc-parser": "3.3.1",
    "picomatch": "^4.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remote-lib-common": "workspace:*",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "uqr": "^0.1.3",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@argos-ci/cli": "^6.9.4",
    "@argos-ci/storybook": "^6.4.0",
    "@storybook/addon-docs": "11.0.0-alpha.1",
    "@storybook/addon-vitest": "11.0.0-alpha.1",
    "@storybook/react": "11.0.0-alpha.1",
    "@storybook/react-vite": "11.0.0-alpha.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "remark-gfm": "^4.0.1",
    "storybook": "11.0.0-alpha.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.14",
    "vitest": "^5.0.0"
  }
}
