{
  "extends": "../tsconfig.workspace-sources.json",
  "compilerOptions": {
    "target": "ES2022",
    // DOM: the Pocket build bakes its first frame from the theme modules.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "vite.pocket.config.ts", "vite.one-time.config.ts", "vite.sw.config.ts", "vitest.argos.config.ts"]
}
