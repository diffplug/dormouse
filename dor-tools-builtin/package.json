{
  "name": "dor-tools-builtin",
  "version": "0.0.0",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./file-viewer-format": {
      "types": "./dist/file-viewer-format.d.ts",
      "default": "./dist/file-viewer-format.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter dor-lib-common build && pnpm --filter dor-tools-lib build",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.viewer.json && node scripts/build.mjs",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@lezer/highlight": "^1.2.5",
    "@mdxeditor/editor": "4.3.1",
    "dor-lib-common": "workspace:*",
    "dor-tools-lib": "workspace:*",
    "lexical": "0.48.0",
    "mermaid": "11.17.2",
    "monaco-editor": "0.55.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.0"
  }
}
