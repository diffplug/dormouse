{
  "name": "server",
  "version": "0.0.0",
  "license": "FSL-1.1-MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter remote-lib-common build",
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm run build && node scripts/dev.mjs",
    "start": "node dist/index.js",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.6.0",
    "remote-lib-common": "workspace:*",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^6.0.3"
  }
}
